{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=IoTDevice.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServerConfiguration": {
    "RestApi": {
      "Port": 5000
    },
    "Tcp": {
      "Port": 6000
    },
    "Udp": {
      "Port": 6001
    },
    "SignalR": {
      "Route": "deviceHub",
      "Port": 5001
    },
    "Grpc": {
      "Port": 5002
    }
  }
}
